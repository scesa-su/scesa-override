# Copy to .env.local for local overrides. Never commit real values.

# Game content. Leave both unset to run the demo puzzle (content/game.example.json).
# Production: base64 JSON, generated with `npm run content:encode -- <file>`.
GAME_CONTENT=
# Local only: path to a real content file kept OUTSIDE this repository.
GAME_CONTENT_FILE=

# Required in production: long random string used to sign the session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Required to open /api/leaderboard?secret=... (the leaderboard stays locked when unset).
LEADERBOARD_SECRET=

# Upstash Redis (set one pair). The Vercel Upstash integration sets the KV_* pair automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Online event (all optional; leave unset for walk-in play).
# Shared start: every team's clock counts from here, and nobody can start before it. Include the offset.
EVENT_START=
# After this, codes and hints are refused and no new team can start.
EVENT_END=
# Registered teams: base64 JSON [{"callsign":"…","code":"123456"}], from `npm run teams:make`.
TEAMS=
# Local only: path to a roster JSON kept OUTSIDE this repository.
TEAMS_FILE=
# Case-file download link shown to teams once they are in.
CASE_FILE_URL=

# Production only: set to 1 to allow a non-persistent in-memory store when no Redis is configured.
ALLOW_MEMORY_STORE=
